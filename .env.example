# =============================================================
# Emby Manager - Docker Compose 环境变量模板
# 用法：复制本文件为 .env 后按需修改
#   Linux/macOS : cp .env.example .env
#   Windows     : copy .env.example .env
# =============================================================

# 宿主机对外暴露端口（容器内固定为 5001）
APP_PORT=5001

# 容器时区（定时同步在每日零点执行，请保持 Asia/Shanghai）
TZ=Asia/Shanghai

# Flask 会话密钥：留空时每次重启容器所有用户需要重新登录。
# 建议设置为任意 32 位以上随机字符串，例如：
#   python -c "import secrets; print(secrets.token_hex(32))"
EMBY_MANAGER_SECRET_KEY=

# Gunicorn 并发配置（SQLite 单机部署建议保持默认；高配机器可适当调大）
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120
